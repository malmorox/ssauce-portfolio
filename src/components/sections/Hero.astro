---
import Lockup from '@components/ui/Lockup.astro';
import Stamp from '@components/easter-eggs/Stamp.astro';
import profile from '@data/profile.json';

// Capa oculta que revela el foco del puntero (decorativa)
const XRAY_ROWS = 16;
const XRAY_TEXT = 'psst… escribe «salsa» en tu teclado ✺ '.repeat(6);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__xray" aria-hidden="true">
    <div class="hero__xray-text">
      {Array.from({ length: XRAY_ROWS }, () => <p>{XRAY_TEXT}</p>)}
    </div>
  </div>
  <span class="crop-marks" aria-hidden="true"></span>

  <div class="wrap hero__inner">
    <div class="hero__top">
      {
        profile.availability.open && (
          <p class="availability">
            <span class="availability__dot" aria-hidden="true" />
            {profile.availability.label}
          </p>
        )
      }
      <p class="hero__roles">{profile.roles.join(' · ')}</p>
      <p class="hero__label" aria-hidden="true">(01) El titular</p>
    </div>

    <div class="hero__name">
      <Lockup
        as="h1"
        id="hero-title"
        lines={[profile.name]}
        base="clamp(2.5rem, 1.5rem + 5vw, 6rem)"
      />
      <span class="hero__sticker sticker" aria-hidden="true">¡con salsa!</span>
    </div>

    <div class="hero__bottom">
      <p class="hero__claim serif-accent">{profile.claim}</p>
      <div class="hero__intro">
        <p>{profile.intro}</p>
        <div class="hero__actions">
          <a class="btn btn--solid" href="/projects">
            Ver proyectos <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn" href="#contacto">Hablemos</a>
        </div>
      </div>
      <div class="hero__stamp"><Stamp /></div>
    </div>
  </div>
</section>

<style>
  @property --spot-inner {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }
  @property --spot-outer {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2rem, 1rem + 4vw, 4rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    min-block-size: calc(100svh - 4.25rem - clamp(5rem, 3rem + 8vw, 9rem));
    align-content: space-between;
  }

  /* ---------- Fila superior ---------- */
  .hero__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .availability__dot {
    position: relative;
    inline-size: 0.7rem;
    block-size: 0.7rem;
    border-radius: 50%;
    background: var(--pop);
    border: 2px solid var(--on-pop);

    @media (prefers-reduced-motion: no-preference) {
      &::after {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 50%;
        border: 2px solid var(--pop);
        animation: pulse 1.6s ease-out 3;
      }
    }
  }

  @keyframes pulse {
    to {
      scale: 2.6;
      opacity: 0;
    }
  }

  .hero__roles,
  .hero__label {
    color: var(--ink-soft);
  }

  .hero__label {
    @media (max-width: 40rem) {
      display: none;
    }
  }

  /* ---------- Nombre ---------- */
  .hero__name {
    position: relative;
    padding-block-start: 0.3em; /* aire para la tilde de la Í */
  }

  .hero__sticker {
    position: absolute;
    inset-block-start: -0.75rem;
    inset-inline-end: 0;
    --tilt: 8deg;
    font-size: clamp(0.7rem, 0.6rem + 0.6vw, 1.1rem);
  }

  /* ---------- Fila inferior ---------- */
  .hero__bottom {
    display: grid;
    gap: 2rem;
    align-items: end;

    @media (min-width: 52rem) {
      grid-template-columns: 1.2fr 1fr auto;
      gap: clamp(2rem, 4vw, 4rem);
    }
  }

  .hero__claim {
    max-inline-size: 18ch;
    font-size: var(--text-display);
    line-height: 1.05;
    color: var(--accent-text);
  }

  .hero__intro {
    display: grid;
    gap: 1.5rem;
    max-inline-size: 38ch;
    font-size: var(--text-lead);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: var(--text-body);
  }

  .hero__stamp {
    justify-self: end;
  }

  /* ---------- Capa de rayos X (foco del puntero) ---------- */
  .hero__xray {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--pop);
    color: var(--on-pop);
    -webkit-mask-image: radial-gradient(
      circle at var(--mx, 50%) var(--my, 50%),
      #000 var(--spot-inner, 0px),
      transparent var(--spot-outer, 0px)
    );
    mask-image: radial-gradient(
      circle at var(--mx, 50%) var(--my, 50%),
      #000 var(--spot-inner, 0px),
      transparent var(--spot-outer, 0px)
    );
    mask-repeat: no-repeat;
    transition:
      --spot-inner 0.35s var(--ease-out-expo),
      --spot-outer 0.35s var(--ease-out-expo);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .hero__xray-text {
    position: absolute;
    inset: -20%;
    display: grid;
    align-content: center;
    gap: 0.6rem;
    rotate: -8deg;
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;

    p:nth-child(even) {
      translate: -6rem 0;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .hero:hover {
      --spot-inner: 80px;
      --spot-outer: 130px;
    }
  }

  /* ---------- Entrada al cargar ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__top {
      animation: hero-in 0.8s var(--ease-out-expo) both;
    }

    .hero__bottom > * {
      --stagger: 0.12s;
      animation: hero-in 0.9s var(--ease-out-expo) both;
      animation-delay: calc(var(--sibling-index) * var(--stagger) + 0.15s);
    }

    @supports (animation-delay: calc(sibling-index() * 0.1s)) {
      .hero__bottom > * {
        animation-delay: calc(sibling-index() * var(--stagger) + 0.15s);
      }
    }

    @supports not (animation-delay: calc(sibling-index() * 0.1s)) {
      .hero__bottom > :nth-child(1) { --sibling-index: 1; }
      .hero__bottom > :nth-child(2) { --sibling-index: 2; }
      .hero__bottom > :nth-child(3) { --sibling-index: 3; }
    }

    .hero__sticker {
      animation: sticker-in 0.7s var(--ease-out-back) 0.9s both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 1.5rem;
    }
  }

  @keyframes sticker-in {
    from {
      opacity: 0;
      scale: 2.2;
      rotate: -20deg;
    }
  }
</style>

<script>
  // Coordenadas del foco: solo con puntero fino (ratón/trackpad)
  const hero = document.querySelector<HTMLElement>('.hero');

  if (hero && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let rect: DOMRect | null = null;
    const invalidate = () => (rect = null);

    new ResizeObserver(invalidate).observe(hero);
    window.addEventListener('scroll', invalidate, { passive: true });

    hero.addEventListener('pointermove', (e) => {
      rect ??= hero.getBoundingClientRect();
      hero.style.setProperty('--mx', `${e.clientX - rect.left}px`);
      hero.style.setProperty('--my', `${e.clientY - rect.top}px`);
    });
  }
</script>
