---
import { SECRETS, SECRET_IDS } from '../../scripts/secrets-data';
---

<div class="secrets" data-secrets>
  <p class="secrets__title">
    Secretos encontrados:{' '}
    <strong><span data-secrets-count>0</span>/{SECRET_IDS.length}</strong>
  </p>
  <ul class="secrets__list">
    {
      SECRET_IDS.map((id) => (
        <li class="secrets__item" data-secret={id} data-name={SECRETS[id].name}>
          <span class="secrets__pip" aria-hidden="true" />
          <span class="secrets__name">
            <span aria-hidden="true">???</span>
            <span class="sr-only">Sin descubrir</span>
          </span>
        </li>
      ))
    }
  </ul>
  <p class="secrets__hint serif-accent">Una buena publicista siempre esconde algo.</p>
  <button class="secrets__picante btn btn--sm" type="button" aria-pressed="false" hidden>
    Modo picante 🌶️
  </button>
</div>

<style>
  .secrets__title {
    font-weight: 600;
  }

  .secrets__list {
    display: grid;
    gap: 0.35rem;
    margin-block: 0.75rem;
  }

  .secrets__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-caption);
    color: var(--ink-soft);
  }

  .secrets__pip {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border: 2px solid var(--line-strong);
    border-radius: 50%;
    transition: background-color 0.3s, border-color 0.3s;
  }

  .secrets__item[data-found] {
    color: var(--ink);

    .secrets__pip {
      border-color: var(--pop);
      background: var(--pop);
    }
  }

  .secrets__hint {
    font-size: var(--text-lead);
    color: var(--ink-soft);
  }

  .secrets__picante {
    margin-block-start: 1rem;

    &[aria-pressed='true'] {
      --btn-bg: var(--accent);
      --btn-fg: var(--on-accent);
    }
  }
</style>

<script>
  import { foundSecrets } from '../../scripts/secrets';
  import { isPicante, togglePicante } from '../../scripts/theme';

  const root = document.querySelector<HTMLElement>('[data-secrets]');
  const picanteButton = root?.querySelector<HTMLButtonElement>('.secrets__picante');

  function render() {
    if (!root) return;
    const found = foundSecrets();
    root.querySelector('[data-secrets-count]')!.textContent = String(found.size);

    root.querySelectorAll<HTMLElement>('[data-secret]').forEach((item) => {
      if (!found.has(item.dataset.secret as never) || item.hasAttribute('data-found')) return;
      item.setAttribute('data-found', '');
      item.querySelector('.secrets__name')!.textContent = `${item.dataset.name} ✓`;
    });

    if (picanteButton) {
      picanteButton.hidden = !found.has('salsa');
      picanteButton.setAttribute('aria-pressed', String(isPicante()));
    }
  }

  picanteButton?.addEventListener('click', togglePicante);
  document.addEventListener('secrets:change', render);
  document.addEventListener('theme:change', render);
  render();
</script>
