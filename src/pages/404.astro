---
import BaseLayout from '@layouts/BaseLayout.astro';
import Lockup from '@components/ui/Lockup.astro';
---

<BaseLayout title="Página no encontrada">
  <section class="section not-found">
    <div class="wrap not-found__inner">
      <p class="not-found__code" aria-hidden="true">404</p>
      <Lockup
        as="h1"
        lines={['Esta página', 'no pasó', { text: 'el brief.', serif: true, class: 'not-found__accent' }]}
        base="clamp(2rem, 1.25rem + 3.5vw, 4.5rem)"
      />
      <p class="not-found__text">
        La rechazamos en la primera reunión con cliente. Pero no te preocupes: el resto del
        portfolio sí está aprobado.
      </p>
      <div class="not-found__actions">
        <a class="btn btn--solid" href="/">Volver al inicio</a>
        <a class="btn" href="/projects">Ver proyectos</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found__inner {
    position: relative;
    display: grid;
    gap: 2rem;
    max-inline-size: 60rem;
  }

  .not-found__code {
    position: absolute;
    inset-block-start: -2rem;
    inset-inline-end: 0;
    z-index: -1;
    font-size: clamp(8rem, 4rem + 18vw, 20rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.8;
    color: var(--paper-2);
  }

  .not-found__inner :global(.not-found__accent) {
    color: var(--accent-text);
  }

  .not-found__text {
    max-inline-size: 44ch;
    font-size: var(--text-lead);
    color: var(--ink-soft);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
